NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=progresspulse
DB_USER=progresspulse
DB_PASSWORD=progresspulse

# JWT — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

# Set true to sync schema + seed on boot (dev only)
DB_SYNC=true
DB_SEED=true
